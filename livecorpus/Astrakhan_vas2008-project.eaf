        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2199" ANNOTATION_REF="a2124">
                <ANNOTATION_VALUE>может быть ещё проверка контакта</ANNOTATION_VALUE>
            </REF_ANNOTATION>
